{
  "dashboard": {
    "title": "Sensor Quality Monitoring Dashboard",
    "tags": ["mlops", "sensors", "anomaly-detection"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "API Requests per Minute",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(api_requests_total[1m])",
            "legendFormat": "{{method}} {{endpoint}}"
          }
        ],
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}
      },
      {
        "id": 2,
        "title": "Request Latency (95th percentile)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(api_request_duration_seconds_bucket[5m]))",
            "legendFormat": "p95 latency"
          }
        ],
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}
      },
      {
        "id": 3,
        "title": "Anomaly Detections",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(anomaly_detections_total{result=\"anomaly\"})",
            "legendFormat": "Anomalies"
          }
        ],
        "gridPos": {"x": 0, "y": 8, "w": 6, "h": 4}
      },
      {
        "id": 4,
        "title": "Drift Events",
        "type": "stat",
        "targets": [
          {
            "expr": "drift_events_total",
            "legendFormat": "Drift Events"
          }
        ],
        "gridPos": {"x": 6, "y": 8, "w": 6, "h": 4}
      },
      {
        "id": 5,
        "title": "Normal vs Anomaly Rate",
        "type": "pie",
        "targets": [
          {
            "expr": "sum by(result) (anomaly_detections_total)"
          }
        ],
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}
      },
      {
        "id": 6,
        "title": "Request Duration Heatmap",
        "type": "heatmap",
        "targets": [
          {
            "expr": "rate(api_request_duration_seconds_bucket[5m])",
            "format": "heatmap"
          }
        ],
        "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8}
      }
    ],
    "schemaVersion": 16,
    "version": 1
  }
}
